  "nodes": [
    {
      "parameters": {
        "path": "vapi-get-context",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "6c737b0d-20ab-40a5-b62b-6c946af58804",
      "name": "A: Webhook — перед звонком",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        1856,
        1344
      ],
      "webhookId": "vapi-get-context"
    },
    {
      "parameters": {
        "jsCode": "// На вход приходят вперемешку строки из обеих нод — различаем их\n// по форме данных (есть ли поле message или поле topic), а не по имени ноды\nconst items = $input.all().map(i => i.json);\n\nconst messageRows = items.filter(r => r.message !== undefined);\nconst topicRows = items.filter(r => r.topic !== undefined);\n\nmessageRows.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));\ntopicRows.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));\n\nconst recentLines = messageRows.map(r => {\n  const msg = r.message || {};\n  const role = msg.type === 'human' ? 'Ученик' : 'Таня';\n  const content = msg.data?.content ?? msg.content ?? '';\n  return `${role}: ${content}`;\n}).join('\\n');\n\nconst topicLines = topicRows\n  .filter(t => t.topic && t.topic !== 'нет темы')\n  .map(t => `- ${t.topic}: ${t.summary || ''}`)\n  .join('\\n');\n\nconst parts = [];\nif (topicLines) parts.push('Что проходили раньше (кратко, по всем прошлым урокам):\\n' + topicLines);\nif (recentLines) parts.push('Последние сообщения в переписке:\\n' + recentLines);\n\nreturn [{ json: { recent_context: parts.length ? parts.join('\\n\\n') : 'Это первый разговор с учеником, истории пока нет.' } }];"
      },
      "id": "00c61c1f-5f4e-474f-9407-875d156dbc69",
      "name": "Собрать recent_context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2336,
        1344
      ]
    },
    {
      "parameters": {
        "jsCode": "const root = $json.body?.message || $json.message || $json;\n\nconst telegramUserId =\n  root.call?.metadata?.telegram_user_id ||\n  root.metadata?.telegram_user_id ||\n  root.call?.assistantOverrides?.metadata?.telegram_user_id ||\n  null;\n\nconst rawMessages = root.artifact?.messages || root.messages || [];\n\nconst filtered = rawMessages\n  .map(m => {\n    const content =\n      typeof m.message === 'string'\n        ? m.message\n        : typeof m.content === 'string'\n          ? m.content\n          : null;\n\n    let type = null;\n\n    if (m.role === 'user') {\n      type = 'human';\n    } else if (\n      m.role === 'assistant' ||\n      m.role === 'bot' ||\n      m.role === 'ai'\n    ) {\n      type = 'ai';\n    }\n\n    if (!type || !content?.trim()) {\n      return null;\n    }\n\n    return {\n      type,\n      content\n    };\n  })\n  .filter(Boolean);\n\nif (!telegramUserId || filtered.length === 0) {\n  return [];\n}\n\nreturn filtered.map(message => ({\n  json: {\n    session_id: String(telegramUserId),\n    message_json: JSON.stringify(message)\n  }\n}));"
      },
