          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Вот новый кусок текстовой переписки ученика с ИИ-репетитором английского (только новые сообщения с прошлой проверки):\n\n{{ $json.transcript }}\n\nВерни СТРОГО валидный JSON без пояснений и без markdown-обрамления, в формате: {\"topic\": \"короткое название темы/грамматики, которую разбирали\", \"summary\": \"2-3 предложения резюме для памяти ассистента\"}. Если по переписке не разбиралась конкретная тема (просто болтовня/оргвопросы) — верни {\"topic\": \"нет темы\", \"summary\": \"\"}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "1165adf4-ee14-45e6-8349-698d05ba8f4b",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1248,
        128
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "ehypoveIlYVLt7tg",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Нативная нода Google Gemini (simplify=true) отдаёт текст в content.parts[0].text.\n// Безопасно перебираем возможные формы ответа.\nconst j = $input.first()?.json ?? {};\nconst raw = j.content?.parts?.[0]?.text\n  ?? j.candidates?.[0]?.content?.parts?.[0]?.text\n  ?? j.text\n  ?? '{}';\nconst cleaned = String(raw).replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { topic: 'не удалось извлечь', summary: cleaned.slice(0, 500) };\n}\n\nconst prev = $('Build transcript').item.json ?? {};\n\nreturn [{\n  json: {\n    telegram_user_id: prev.telegram_user_id ?? null,\n    topic: parsed?.topic ?? 'нет темы',\n    summary: parsed?.summary ?? ''\n  }\n}];"
      },
