    {
      "parameters": {
        "jsCode": "// Все строки n8n_chat_histories для ТЕКУЩЕГО студента (безопасно —\n// мы внутри одной итерации Loop students, чужие пользователи сюда не попадут)\nconst rows = $input.all().map(i => i.json);\n\nconst lines = rows.map(r => {\n  const msg = r.message || {};\n  const role = msg.type === 'human' ? 'Ученик' : 'Бот';\n  const content = msg.data?.content ?? msg.content ?? '';\n  return `${role}: ${content}`;\n}).join('\\n');\n\n// created_at отсортирован по возрастанию (order=created_at.asc в запросе),\n// значит последняя строка — самое свежее сообщение из новых\nconst lastMessageAt = rows.length ? rows[rows.length - 1].created_at : null;\nconst idleMinutes = lastMessageAt ? (Date.now() - new Date(lastMessageAt).getTime()) / 60000 : 0;\n\nconst student = $('Loop students').item.json;\n\nreturn [{\n  json: {\n    telegram_user_id: student.telegram_user_id,\n    message_count: rows.length,\n    transcript: lines,\n    last_message_at: lastMessageAt,\n    idle_minutes: idleMinutes\n  }\n}];"
      },
      "id": "aa52d377-991c-46b5-9a54-fa89a96cc069",
      "name": "Build transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.message_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b28a74bd-c47e-47a5-ad2c-78b8b8902283",
      "name": "Есть новые сообщения?",
